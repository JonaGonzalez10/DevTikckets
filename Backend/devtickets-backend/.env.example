# Copia este archivo como ".env" y completa los valores reales. NO subas el ".env".
SERVER_PORT=8080

# Base de datos (TiDB Cloud / MySQL)
DB_HOST=tu-host.tidbcloud.com
DB_PORT=4000
DB_NAME=devtickets
DB_USER=tu_usuario
DB_PASSWORD=cambia_esta_contrasena

JPA_DDL_AUTO=none

# Genera uno largo y aleatorio (minimo 32 caracteres)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRATION_MINUTES=120

CORS_ORIGINS=http://localhost:4200
RESERVATION_EXPIRATION_MINUTES=10
